# ─── Supabase (required) ───────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used by the seed script and the walk-in patient registration action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed to apply migrations from the CLI (Connect → Session pooler URI).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Sponsor: SerpApi (optional — labeled mock data when missing) ──────
# Server only. Clinic + pharmacy discovery via the google_maps engine.
SERPAPI_API_KEY=

# ─── Sponsor: You.com (optional — labeled offline sample when missing) ──
# Server only. Doctor Copilot + patient prescription explanations (Answer API).
YOU_API_KEY=

# ─── Sponsor: Nexconn (optional — Supabase Realtime fallback when missing)
# App key is public (used by the browser SDK); the secret is server only.
NEXT_PUBLIC_NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center of your Nexconn app: sg | na | sa
NEXT_PUBLIC_NEXCONN_REGION=sg
